+        private static int squaredDistance(final int dx, final int dz) {
+            return (dx * dx) + (dz * dz);
+        }
+
+        private void tickExtendedView(final long maxSendsThisTick) {
+            final ExtendedViewDistance extendedView = this.world.extendedViewDistance();
+            int nearestUnfinished = this.vvBuildQueue.isEmpty()
+                ? Integer.MAX_VALUE
+                : squaredDistance(
+                    CoordinateUtils.getChunkX(this.vvBuildQueue.firstLong()) - this.lastChunkX,
+                    CoordinateUtils.getChunkZ(this.vvBuildQueue.firstLong()) - this.lastChunkZ
+                );
+
+            for (int i = 0, size = this.vvBuildingQueue.size(); i < size; ++i) {
+                final long chunkKey = this.vvBuildingQueue.getLong(i);
+                final int chunkX = CoordinateUtils.getChunkX(chunkKey);
+                final int chunkZ = CoordinateUtils.getChunkZ(chunkKey);
+                final Result result = extendedView.tryLoad(chunkX, chunkZ).getNow(null);
+                if (result == null || !result.isSuccess()) {
+                    nearestUnfinished = Math.min(nearestUnfinished, squaredDistance(chunkX - this.lastChunkX, chunkZ - this.lastChunkZ));
+                }
+            }
+
+            for (final LongIterator iterator = this.vvBuildingQueue.iterator(); iterator.hasNext(); ) {
+                final long chunkKey = iterator.nextLong();
+                final int chunkX = CoordinateUtils.getChunkX(chunkKey);
+                final int chunkZ = CoordinateUtils.getChunkZ(chunkKey);
+                final CompletableFuture<Result> future = extendedView.tryLoad(chunkX, chunkZ);
+                if (!future.isDone()) {
+                    continue;
+                }
+                final Result result = future.getNow(null);
+                if (result == null || !result.isSuccess()) {
+                    if (this.pendingForget.remove(chunkKey)) {
+                        this.sendForgetChunk(chunkX, chunkZ);
+                    }
+                    iterator.remove();
+                    continue;
+                }
+                if (squaredDistance(chunkX - this.lastChunkX, chunkZ - this.lastChunkZ) <= nearestUnfinished) {
+                    this.sendQueue.enqueue(chunkKey);
+                    iterator.remove();
+                }
+            }
+
+            while (!this.vvBuildQueue.isEmpty()) {
+                final long chunkKey = this.vvBuildQueue.dequeueLong();
+                extendedView.tryLoad(CoordinateUtils.getChunkX(chunkKey), CoordinateUtils.getChunkZ(chunkKey));
+                this.vvBuildingQueue.add(chunkKey);
+            }
+
+            for (long i = 0; i < maxSendsThisTick && !this.sendQueue.isEmpty(); ++i) {
+                final long chunkKey = this.sendQueue.firstLong();
+                final int chunkX = CoordinateUtils.getChunkX(chunkKey);
+                final int chunkZ = CoordinateUtils.getChunkZ(chunkKey);
+                if (this.wantChunkSent(chunkX, chunkZ)) {
+                    break;
+                }
+
+                this.sendQueue.dequeueLong();
+                final Result result = extendedView.tryLoad(chunkX, chunkZ).getNow(null);
+                if (this.wantChunkInVVRange(chunkX, chunkZ) && !this.sentChunks.contains(chunkKey)) {
+                    if (result == null || !result.isSuccess()) {
+                        throw new IllegalStateException("fake chunk was unsuccessful but passed into send queue");
+                    }
+                    this.sentChunks.add(chunkKey);
+                    this.fakeChunks.add(chunkKey);
+                    extendedView.cache.watch(chunkKey);
+                    this.pendingForget.remove(chunkKey);
+                    this.player.connection.send(result.getPacketOrThrow());
+                } else if (result != null && result.isSuccess()) {
+                    extendedView.cache.evictIfUnwatched(chunkKey);
+                }
+            }
+        }
